# Cloud Gemini uses Firebase AI Logic (Gemini API in Firebase Console for com.sitedairy.app).
# No separate API key is required — see src/config/firebase.ts and src/native/GeminiCloud.ts.

# Azure ChatGPT (Azure OpenAI) — used by the Chat tab. Copy this file to .env and fill in.
# NOTE: EXPO_PUBLIC_ vars are embedded in plain text in the app bundle (Expo limitation),
# so this key is visible to anyone with the built app. Use a key you are comfortable shipping.
EXPO_PUBLIC_AZURE_OPENAI_API_KEY=
EXPO_PUBLIC_AZURE_OPENAI_ENDPOINT=https://gcl-superapp-ai-dev.openai.azure.com/openai/v1
EXPO_PUBLIC_AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
EXPO_PUBLIC_AZURE_OPENAI_API_VERSION=v1
