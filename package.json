{
  "name": "sitediary",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node ./node_modules/expo/bin/cli start",
    "start:clean": "node ./node_modules/expo/bin/cli start --clear",
    "android": "node scripts/android.cjs",
    "android:clean": "node scripts/android.cjs --no-build-cache",
    "android:release": "node scripts/android-release.cjs",
    "android:verify-apk": "node scripts/verify-apk-bundle.cjs",
    "ios": "node ./node_modules/expo/bin/cli run:ios",
    "web": "node ./node_modules/expo/bin/cli start --web",
    "prebuild": "node ./node_modules/expo/bin/cli prebuild",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.cjs",
    "postinstall": "patch-package && node ./node_modules/llama.rn/install/download-native-artifacts.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.4.2",
    "@siteed/sherpa-onnx.rn": "1.3.1",
    "expo": "~56.0.12",
    "expo-audio": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.19",
    "expo-image-picker": "~56.0.18",
    "expo-location": "~56.0.20",
    "expo-status-bar": "~56.0.4",
    "firebase": "^12.15.0",
    "i18next": "^26.3.4",
    "jpeg-js": "^0.4.4",
    "llama.rn": "^0.12.5",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
