diff --git a/node_modules/onnxruntime-react-native/android/CMakeLists.txt b/node_modules/onnxruntime-react-native/android/CMakeLists.txt
index 2f814e8..ce475cb 100644
--- a/node_modules/onnxruntime-react-native/android/CMakeLists.txt
+++ b/node_modules/onnxruntime-react-native/android/CMakeLists.txt
@@ -87,6 +87,14 @@ set_target_properties(
              CXX_EXTENSIONS OFF
              POSITION_INDEPENDENT_CODE ON)
 
+# Android 15+ requires native libraries to support 16 KB memory page sizes.
+# The NDK defaults to 4 KB ELF segment alignment, which makes libonnxruntimejsi.so
+# fail Google Play's / the installer's 16 KB alignment check. Force 16 KB alignment.
+# (matches microsoft/onnxruntime PR #27523; not present in 1.24.3)
+if(ANDROID)
+  target_link_options(onnxruntimejsi PRIVATE "-Wl,-z,max-page-size=16384")
+endif()
+
 find_library(log-lib log)
 
 target_link_libraries(
