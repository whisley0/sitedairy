   }
 
-  if (VersionNumber.parse(REACT_NATIVE_VERSION) < VersionNumber.parse("0.71")) {
+  // Patched: org.gradle.util.VersionNumber was removed in Gradle 9 (used by SDK 56 / RN 0.85).
+  // The fbjni headers branch only applied to React Native < 0.71, which this toolchain is far past,
+  // so we compare the version numerically instead of relying on the removed VersionNumber API.
+  def rnMinor = (REACT_NATIVE_VERSION =~ /^\d+\.(\d+)/) ? ((REACT_NATIVE_VERSION =~ /^\d+\.(\d+)/)[0][1] as int) : 99
+  if (rnMinor < 71) {
     extractLibs "com.facebook.fbjni:fbjni:+:headers"
     extractLibs "com.facebook.fbjni:fbjni:+"
   }
